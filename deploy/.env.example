# Copy to deploy/.env and fill in. Never commit the filled-in file.

# --- This service's own Postgres (the postgres service in docker-compose.yml) ---
# Three roles (deploy/postgres-init/10-roles.sh creates the last two when the
# volume is first created):
#   postgres     the superuser: the init script and emergencies only
#   admin_owner  owns the schema; only the one-shot `migrate` service uses it
#   admin_app    the API: no DDL; audit_events is SELECT/INSERT only
POSTGRES_PASSWORD=change-me-superuser
ADMIN_OWNER_PASSWORD=change-me-owner
ADMIN_APP_PASSWORD=change-me-app
# Each URL repeats its role's password.
ADMIN_MIGRATE_DATABASE_URL=postgresql+psycopg://admin_owner:change-me-owner@postgres:5432/admin
ADMIN_DATABASE_URL=postgresql+psycopg://admin_app:change-me-app@postgres:5432/admin

# The hospital service's platform API on the endod-bus network, and its key
# (the hospital service's HOSPITAL_PLATFORM_ADMIN_KEY). Only the API container
# holds it; it never reaches the browser.
HOSPITAL_API_URL=http://endod-hospital-api:8000
HOSPITAL_PLATFORM_KEY=

# TenaCare's platform API (company applications; docs/company-onboarding.md)
# on endod-bus, and its key (TenaCare's ORG_PLATFORM_KEY, the same value). Only
# the API container holds it; it never reaches the browser. Leave it empty
# until TenaCare is deployed: the company pages then say "not connected yet".
ORGANISATION_API_URL=http://endod-organisation-api:8000
ORGANISATION_PLATFORM_KEY=

# The patient platform's internal API (internal-api, "endod-platform-api" on
# endod-bus) and its super admin key (the platform's SUPERADMIN_API_KEY, the
# same value; at least 32 characters, never the platform's ADMIN_API_KEY,
# which is its session secret). Users, Digital cards, the dashboard's patient
# counts and the platform's health report use it. Only the API container
# holds it; it never reaches the browser. Empty: those pages say "not connected yet".
PLATFORM_API_URL=http://endod-platform-api:8000
SUPERADMIN_API_KEY=

# At least 32 random characters each, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# SESSION_SECRET keys session and setup-link hashes and encrypts TOTP secrets:
# changing it signs everyone out and voids every authenticator (run reset-2fa for each admin).
SESSION_SECRET=
# Shared by the web app and the API (sent as X-BFF-Secret); the API refuses
# every request without it, except /health.
BFF_SHARED_SECRET=
# Shared by the web app and our nginx, which sends it as X-Endod-Edge-Key on
# every request to admin.endod-health.com. With an https SITE_ORIGIN the web app
# answers 403 to any request without it (other containers on the shared edge
# network), except its own healthcheck from localhost, and 503 to everything
# while it is unset or shorter than 32 characters. Never put it in a URL or log.
EDGE_SHARED_SECRET=

# The public origin: setup links point here and the web app accepts changes only from it.
# With https here, the web app also insists on nginx's X-Endod-Client-IP header (503 without it).
SITE_ORIGIN=https://admin.endod-health.com

# Optional.
# SHARED_NGINX_NETWORK=eyita_edge
