# Copy to deploy/.env and fill in. Never commit the filled-in file.

# This service's own Postgres (the postgres service in docker-compose.yml).
# The password here and in ADMIN_DATABASE_URL must be the same.
POSTGRES_PASSWORD=change-me-long-random
ADMIN_DATABASE_URL=postgresql+psycopg://admin:change-me-long-random@postgres:5432/admin

# The hospital service's platform API on the endod-bus network, and its key
# (the hospital service's HOSPITAL_PLATFORM_ADMIN_KEY). Only the API container
# holds it; it never reaches the browser.
HOSPITAL_API_URL=http://endod-hospital-api:8000
HOSPITAL_PLATFORM_KEY=

# At least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# It keys session and setup-link hashes and encrypts TOTP secrets: changing it
# signs everyone out and voids every authenticator (run reset-2fa for each admin).
SESSION_SECRET=

# The public origin: setup links point here and the web app accepts changes only from it.
SITE_ORIGIN=https://admin.endod-health.com

# Optional.
# SHARED_NGINX_NETWORK=eyita_edge
# TRUSTED_PROXY_HOPS=2
